{
  "info": {
    "name": "JSONPlaceholder API Tests - Sankalp",
    "description": "REST API test collection on the public JSONPlaceholder API (https://jsonplaceholder.typicode.com). Covers GET, POST, PUT, PATCH, DELETE with status, schema, data and negative checks. Run in Postman or with: newman run JSONPlaceholder.postman_collection.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://jsonplaceholder.typicode.com"
    }
  ],
  "item": [
    {
      "name": "Posts",
      "item": [
        {
          "name": "API_01 GET all posts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response time is under 2 seconds', () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "const allPosts = pm.response.json();",
                  "pm.test('Returns 100 posts', () => pm.expect(allPosts).to.have.lengthOf(100));",
                  "pm.test('Content-Type is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            }
          }
        },
        {
          "name": "API_02 GET single post - schema check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const post = pm.response.json();",
                  "pm.test('Post has the right fields and types', () => {",
                  "  pm.expect(post).to.have.all.keys('userId', 'id', 'title', 'body');",
                  "  pm.expect(post.id).to.eql(1);",
                  "  pm.expect(post.userId).to.be.a('number');",
                  "  pm.expect(post.title).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "1"
              ]
            }
          }
        },
        {
          "name": "API_03 GET post that does not exist (negative)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Body is an empty object', () => pm.expect(pm.response.json()).to.eql({}));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/9999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "9999"
              ]
            }
          }
        },
        {
          "name": "API_04 GET posts filtered by user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const posts = pm.response.json();",
                  "pm.test('Every post belongs to user 1', () => {",
                  "  pm.expect(posts.length).to.be.above(0);",
                  "  posts.forEach((p) => pm.expect(p.userId).to.eql(1));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts?userId=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ],
              "query": [
                {
                  "key": "userId",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "API_05 POST create a post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('New post gets id 101', () => pm.expect(body.id).to.eql(101));",
                  "pm.test('Saved data matches what we sent', () => {",
                  "  pm.expect(body.title).to.eql('QA test post');",
                  "  pm.expect(body.userId).to.eql(1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"QA test post\",\n  \"body\": \"Created by the Postman collection\",\n  \"userId\": 1\n}"
            }
          }
        },
        {
          "name": "API_06 PUT replace a post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Title is updated', () => pm.expect(pm.response.json().title).to.eql('Updated title'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"title\": \"Updated title\",\n  \"body\": \"Updated body\",\n  \"userId\": 1\n}"
            }
          }
        },
        {
          "name": "API_07 PATCH update one field",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Only the title changed', () => {",
                  "  pm.expect(body.title).to.eql('Patched title');",
                  "  pm.expect(body.body).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Patched title\"\n}"
            }
          }
        },
        {
          "name": "API_08 DELETE a post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "1"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Users and comments",
      "item": [
        {
          "name": "API_09 GET user - email format",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const user = pm.response.json();",
                  "pm.test('Email has a valid format', () => pm.expect(user.email).to.match(/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/));",
                  "pm.test('User has an address with a city', () => pm.expect(user.address.city).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "1"
              ]
            }
          }
        },
        {
          "name": "API_10 GET comments of a post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response time is under 2 seconds', () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "const comments = pm.response.json();",
                  "pm.test('All comments are for post 1', () => comments.forEach((c) => pm.expect(c.postId).to.eql(1)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/comments?postId=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "comments"
              ],
              "query": [
                {
                  "key": "postId",
                  "value": "1"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
